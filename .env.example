# The Movie Database (TMDB) API Key
# Get your free key at: https://developer.themoviedb.org/docs/getting-started
VITE_TMDB_API_KEY=your_api_key_here

# OMDb API Key (used for real IMDb + Rotten Tomatoes ratings in Tonight's Pick)
# Get your free key (1,000 req/day) at: https://www.omdbapi.com/apikey.aspx
VITE_OMDB_API_KEY=your_omdb_key_here
